[Desktop Entry]
Type=Application
Name=Files
Name[ru]=Файлы
GenericName=File Manager
GenericName[ru]=Файловый менеджер
Comment=Browse files and see what takes up disk space
Comment[ru]=Просмотр файлов и анализ занятого места
Exec=conchy-files %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
StartupWMClass=conchy-files
Categories=System;FileTools;FileManager;Core;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;space;usage;папка;проводник;диск;место;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Name[ru]=Новое окно
Exec=conchy-files
